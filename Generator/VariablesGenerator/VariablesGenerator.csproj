  <PropertyGroup>
    <PostBuildEvent>where "TextTransform.exe" /Q
IF %25ERRORLEVEL%25 NEQ 0 (
echo [VariablesSystem] TextTransform.exe was not found
exit /b
) else (
echo [VariablesSystem] TextTransform.exe was found
)

echo [VariablesSystem] Deleting $(ProjectDir)Generated
del /F /Q  /S "$(ProjectDir)Generated\" &gt;nul

echo [VariablesSystem] Generating template classes
"TextTransform.exe" "$(ProjectDir)Templates\GenericVariableGenerator.tt"
echo [VariablesSystem] Generating template classes DONE

set ProjectGeneratedFolder=$(ProjectDir)Generated

if "$(SolutionName)"=="UE4" (
set TargetProjectFolder=$(SolutionDir)Engine\Plugins\Marketplace\VariablesSystem\
) else (
set TargetProjectFolder=$(ProjectDir)..\..\
)

set TargetGeneratedFolder=%25TargetProjectFolder%25Source\VariablesSystem\Generated

echo [VariablesSystem] Updating template classes from %25ProjectGeneratedFolder%25 to %25TargetGeneratedFolder%25
(robocopy "%25ProjectGeneratedFolder%25" "%25TargetGeneratedFolder%25" /E /MIR /NFL /NDL /NJH /NJS /nc /ns /np) ^&amp; IF %25ERRORLEVEL%25 LEQ 1 (
set ERRORLEVEL=0)
echo [VariablesSystem] Updating done!
echo.
) 

echo [VariablesSystem] Deleting build files to trigger rebuild
echo [VariablesSystem] Deleting %25TargetProjectFolder%25Binaries
del /F /Q /S "%25TargetProjectFolder%25Binaries" &gt; nul
echo [VariablesSystem] Deleting %25TargetProjectFolder%25Intermediate
del /F /Q /S "%25TargetProjectFolder%25Intermediate" &gt; nul
echo [VariablesSystem] Deleting done. Ready to rebuild</PostBuildEvent>
