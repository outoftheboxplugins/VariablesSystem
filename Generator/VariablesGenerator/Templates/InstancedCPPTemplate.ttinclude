		<#=variable.Value.globalVariable.valueType#>& other<#=variable.Key#>Ref = OtherVariable->GetInstanced<#=variable.Key#>Ref(OtherOwner);

		if(<#=variable.Key#>Ref != other<#=variable.Key#>Ref)
