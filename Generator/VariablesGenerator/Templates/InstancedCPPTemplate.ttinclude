/* STATIC */ void UInstanced<#=variable.Key.Name#>::CopyInstanced<#=variable.Key.Name#>Value(UObject* Owner, UInstanced<#=variable.Key.Name#>* Variable, UObject* OtherOwner, UInstanced<#=variable.Key.Name#>* OtherVariable)
