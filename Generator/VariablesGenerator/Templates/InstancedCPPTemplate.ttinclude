<#=variable.Value.globalVariable.valueType#>& UInstanced<#=variable.Key.Name#>::GetInstanced<#=variable.Key.Name#>Ref(UObject* Owner)
{
	return VariablesMap.FindOrAdd(Owner);;
}

<#+
