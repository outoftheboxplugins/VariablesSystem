/* STATIC */ void UInstanced<#=variable.Key#>::CopyInstanced<#=variable.Key#>Value(UObject* Owner, UInstanced<#=variable.Key#>* Variable, UObject* OtherOwner, UInstanced<#=variable.Key#>* OtherVariable)
{
	if (!Owner || !OtherOwner)
