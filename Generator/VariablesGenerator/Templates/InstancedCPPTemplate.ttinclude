void UInstanced<#=variable.Key#>::CleanupEntries()
{
	int32 index = 0;
	while(index < VariablesMap.Num())
	{
		TArray<FWeakObjectPtr> Owners;
		VariablesMap.GetKeys(Owners);

		if (!Owners[index].IsValid())
		{
			VariablesMap.Remove(Owners[index]);
		}
		else
		{
			index++;
		}
	}
}

<#=variable.Value.globalVariable.valueType#>& UInstanced<#=variable.Key#>::GetInstanced<#=variable.Key#>Ref(UObject* Owner)
{
	return VariablesMap.FindOrAdd(Owner);;
}

<#+
	if(variable.Value.debugInfo != null)
	{
#>
FString UInstanced<#=variable.Key#>::GetStringValue() const
{
    FString Lines;

    for (auto& Variable : VariablesMap)
    {
        const auto& Value = Variable.Value;
        const auto& Owner = Variable.Key;

		FString ValueString = GetValueAsString(Value);
		FString OwnerString = Owner.IsValid() ? Owner.Get()->GetName() : FString("Invalid Owner");
		FString Line = FString::Printf(TEXT("%s - %s \n"), *OwnerString, *ValueString);

		Lines.Append(Line);
    }

    Lines.TrimEndInline();

    if (Lines.IsEmpty())
    {
        Lines = FString("No values set yet.");
    }

    return Lines;
}

FString UInstanced<#=variable.Key#>::GetValueAsString(<#=variable.Value.globalVariable.valueType#> Value) const
{
