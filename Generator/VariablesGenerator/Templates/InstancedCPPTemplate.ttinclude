/* STATIC */ void UInstanced<#=variable.Key.Name#>::SetInstanced<#=variable.Key.Name#>Value(UObject* Owner, UInstanced<#=variable.Key.Name#>* Variable, <#=variable.Value.globalVariable.valueType#> NewValue)
