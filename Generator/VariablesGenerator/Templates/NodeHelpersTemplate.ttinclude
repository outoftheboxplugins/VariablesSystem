<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#@ assembly name="VariablesGenerator.dll" #>

<#+
void GeneratePinTypeFromVariable(Dictionary<System.Type, GlobalVariable> variables)
{
    for (int i = 0; i < variables.Count; i++)
    {
#>
    if (VariableClassName == FName("Global<#=variables.Keys.ElementAt(i).Name#>"))
    {
        ResultPinType.PinCategory = UEdGraphSchema_K2::PC_<#=variables.Values.ElementAt(i).globalVariable.nodeType#>;
        ResultContainerType = EPinContainerType::<#=variables.Values.ElementAt(i).globalVariable.nodeContainer#>;
<#+
    if (variables.Values.ElementAt(i).globalVariable.nodeSubType != "")
    {
#>
        ResultPinType.PinSubCategoryObject = <#=variables.Values.ElementAt(i).globalVariable.nodeSubType#>;
<#+
    }
#>
    }
    if (VariableClassName == FName("Instanced<#=variables.Keys.ElementAt(i).Name#>"))
    {
        ResultPinType.PinCategory = UEdGraphSchema_K2::PC_<#=variables.Values.ElementAt(i).globalVariable.nodeType#>;
        ResultContainerType = EPinContainerType::<#=variables.Values.ElementAt(i).globalVariable.nodeContainer#>;
<#+
            if (variables.Values.ElementAt(i).globalVariable.nodeSubType != "")
            {
#>
        ResultPinType.PinSubCategoryObject = <#=variables.Values.ElementAt(i).globalVariable.nodeSubType#>;
<#+
    }
#>
    }
<#+
    }
}
#>

<#+
void GenerateCreateSpecificNodeGet(Dictionary<System.Type, GlobalVariable> variables)
{
    for (int i = 0; i < variables.Count; i++)
    {
#>
    if (VariableClassName == FName("Global<#=variables.Keys.ElementAt(i).Name#>"))
    {
        resultCreateNode->FunctionReference.SetExternalMember(GET_FUNCTION_NAME_CHECKED(UGlobal<#=variables.Keys.ElementAt(i).Name#>, GetGlobal<#=variables.Keys.ElementAt(i).Name#>Value), UGlobal<#=variables.Keys.ElementAt(i).Name#>::StaticClass());
    }
    if (VariableClassName == FName("Instanced<#=variables.Keys.ElementAt(i).Name#>"))
    {
        resultCreateNode->FunctionReference.SetExternalMember(GET_FUNCTION_NAME_CHECKED(UInstanced<#=variables.Keys.ElementAt(i).Name#>, GetInstanced<#=variables.Keys.ElementAt(i).Name#>Value), UInstanced<#=variables.Keys.ElementAt(i).Name#>::StaticClass());
    }
<#+
    }
}
#>

<#+
void GenerateCreateSpecificNodeSet(Dictionary<System.Type, GlobalVariable> variables)
{
    for (int i = 0; i < variables.Count; i++)
    {
#>
        if (VariableClassName == FName("Global<#=variables.Keys.ElementAt(i).Name#>"))
        {
            resultCreateNode->FunctionReference.SetExternalMember(GET_FUNCTION_NAME_CHECKED(UGlobal<#=variables.Keys.ElementAt(i).Name#>, SetGlobal<#=variables.Keys.ElementAt(i).Name#>Value), UGlobal<#=variables.Keys.ElementAt(i).Name#>::StaticClass());
        }

        if (VariableClassName == FName("Instanced<#=variables.Keys.ElementAt(i).Name#>"))
        {
            resultCreateNode->FunctionReference.SetExternalMember(GET_FUNCTION_NAME_CHECKED(UInstanced<#=variables.Keys.ElementAt(i).Name#>, SetInstanced<#=variables.Keys.ElementAt(i).Name#>Value), UInstanced<#=variables.Keys.ElementAt(i).Name#>::StaticClass());
        }
<#+
    }
}
#>