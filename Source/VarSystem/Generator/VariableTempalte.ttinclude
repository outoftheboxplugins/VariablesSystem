<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#+ // Start of class feature control block.
void GenerateHFile(string ClassName, string ClassType, string classDefault)
{
#>
// Copyright Out-of-the-Box Plugins 2018-2019. All Rights Reserved.

#pragma once

#include "UObject/Object.h"
#include "UObject/ObjectMacros.h"
#include "BaseVariable.h"
#include "Global<#=ClassName#>Variable.generated.h"

/**
 *
 */

UCLASS(BlueprintType)
class VARSYSTEM_API UGlobal<#=ClassName#>Variable : public UBaseVariable
{
	GENERATED_BODY()

public:
	UPROPERTY(BlueprintReadWrite, EditAnywhere, Category = "Var System")
		<#=ClassType#> value;
	
	// Get the value of a <#=ClassType#> variable.
	UFUNCTION(BlueprintPure, Category = "Var System", meta = (BlueprintThreadSafe))
	static <#=ClassType#> GetGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* var);

	// Get the value of a <#=ClassType#> variable.
	<#=ClassType#> GetGlobal<#=ClassName#>Value();

	// Set the value of a <#=ClassType#> variable.
	UFUNCTION(BlueprintCallable, Category = "Var System")
	static void SetGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* var, <#=ClassType#> _value);

	// Set the value of a <#=ClassType#> variable.
	void SetGlobal<#=ClassName#>Value(<#=ClassType#> _value);
	
	// Copy the value of a <#=ClassType#> variable.
	UFUNCTION(BlueprintCallable, Category = "Var System")
	static void CopyGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* var, UGlobal<#=ClassName#>Variable* other);

	// Copy the value of a <#=ClassType#> variable.
	void CopyGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* other);

	/**** Base Variable Overrides ****/

	virtual void Save() override;

	virtual void Load() override;
};
<#+
}
#>

<#+ // Start of class feature control block.
void GenerateCPPFile(string ClassName, string ClassType, string classDefault)
{
#>
// Copyright Out-of-the-Box Plugins 2018-2019. All Rights Reserved.

#include "Global<#=ClassName#>Variable.h"
#include "Kismet/GameplayStatics.h"

<#=ClassType#> UGlobal<#=ClassName#>Variable::GetGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* var)
{
	if (var == nullptr)
	{
		UE_LOG(LogTemp, Warning, TEXT("Missing variable"));
		return <#=classDefault#>;
	}
	else
	{
		return var->value;
	}
}

<#=ClassType#> UGlobal<#=ClassName#>Variable::GetGlobal<#=ClassName#>Value()
{
	return GetGlobal<#=ClassName#>Value(this);
}

void UGlobal<#=ClassName#>Variable::SetGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* var, <#=ClassType#> _value)
{
	if (!var) return;

	var->value = _value;
	var->dirty = true;
}

void UGlobal<#=ClassName#>Variable::SetGlobal<#=ClassName#>Value(<#=ClassType#> _value)
{
	SetGlobal<#=ClassName#>Value(this, _value);
}

void UGlobal<#=ClassName#>Variable::CopyGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* var, UGlobal<#=ClassName#>Variable* other)
{
	if (!var) return;

	var->value = other->value;
	var->dirty = true;
}

void UGlobal<#=ClassName#>Variable::CopyGlobal<#=ClassName#>Value(UGlobal<#=ClassName#>Variable* other)
{
	CopyGlobal<#=ClassName#>Value(this, other);
}

void UGlobal<#=ClassName#>Variable::Save()
{
	if (dirty == false)
	{
		return;
	}

	UGameplayStatics::SaveGameToSlot(this, GetSaveLocation(), 0);
	dirty = false;
}

void UGlobal<#=ClassName#>Variable::Load()
{
	UGlobal<#=ClassName#>Variable* LoadGameInstance = Cast<UGlobal<#=ClassName#>Variable>(UGameplayStatics::CreateSaveGameObject(UGlobal<#=ClassName#>Variable::StaticClass()));
	LoadGameInstance = Cast<UGlobal<#=ClassName#>Variable>(UGameplayStatics::LoadGameFromSlot(GetSaveLocation(), 0));
	
	if (LoadGameInstance != nullptr)
	{
		this->value = LoadGameInstance->value;
	}
}


<#+
}
#>