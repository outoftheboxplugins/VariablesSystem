<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#+ // Start of class feature control block.
void GenerateHFile(string ClassName, string ClassType, string classDefault)
{
#>
// Copyright Out-of-the-Box Plugins 2018-2019. All Rights Reserved.

#pragma once

#include "UObject/Object.h"
#include "UObject/ObjectMacros.h"
#include "BaseVariable.h"
#include "<#=ClassName#>Variable.generated.h"

/**
 *
 */

UCLASS(BlueprintType)
class VARSYSTEM_API U<#=ClassName#>Variable : public UBaseVariable
{
	GENERATED_BODY()

public:
	UPROPERTY(BlueprintReadWrite, EditAnywhere, Category = "Var System")
		<#=ClassType#> value;
	
	// Get the value of a <#=ClassType#> variable.
	UFUNCTION(BlueprintPure, Category = "Var System", meta = (BlueprintThreadSafe))
	static <#=ClassType#> Get<#=ClassName#>Value(U<#=ClassName#>Variable* var);

	// Get the value of a <#=ClassType#> variable.
	<#=ClassType#> Get<#=ClassName#>Value();

	// Set the value of a <#=ClassType#> variable.
	UFUNCTION(BlueprintCallable, Category = "Var System")
	static void Set<#=ClassName#>Value(U<#=ClassName#>Variable* var, <#=ClassType#> _value);

	// Set the value of a <#=ClassType#> variable.
	void Set<#=ClassName#>Value(<#=ClassType#> _value);
	
	// Copy the value of a <#=ClassType#> variable.
	UFUNCTION(BlueprintCallable, Category = "Var System")
	static void Copy<#=ClassName#>Value(U<#=ClassName#>Variable* var, U<#=ClassName#>Variable* other);

	// Copy the value of a <#=ClassType#> variable.
	void Copy<#=ClassName#>Value(U<#=ClassName#>Variable* other);

	/**** Base Variable Overrides ****/

	virtual void Save() override;

	virtual void Load() override;
};
<#+
}
#>

<#+ // Start of class feature control block.
void GenerateCPPFile(string ClassName, string ClassType, string classDefault)
{
#>
// Copyright Out-of-the-Box Plugins 2018-2019. All Rights Reserved.

#include "<#=ClassName#>Variable.h"
#include "Kismet/GameplayStatics.h"

<#=ClassType#> U<#=ClassName#>Variable::Get<#=ClassName#>Value(U<#=ClassName#>Variable* var)
{
	if (var == nullptr)
	{
		UE_LOG(LogTemp, Warning, TEXT("Missing variable"));
		return <#=classDefault#>;
	}
	else
	{
		return var->value;
	}
}

<#=ClassType#> U<#=ClassName#>Variable::Get<#=ClassName#>Value()
{
	return Get<#=ClassName#>Value(this);
}

void U<#=ClassName#>Variable::Set<#=ClassName#>Value(U<#=ClassName#>Variable* var, <#=ClassType#> _value)
{
	if (!var) return;

	var->value = _value;
	var->dirty = true;
}

void U<#=ClassName#>Variable::Set<#=ClassName#>Value(<#=ClassType#> _value)
{
	Set<#=ClassName#>Value(this, _value);
}

void U<#=ClassName#>Variable::Copy<#=ClassName#>Value(U<#=ClassName#>Variable* var, U<#=ClassName#>Variable* other)
{
	if (!var) return;

	var->value = other->value;
	var->dirty = true;
}

void U<#=ClassName#>Variable::Copy<#=ClassName#>Value(U<#=ClassName#>Variable* other)
{
	Copy<#=ClassName#>Value(this, other);
}

void U<#=ClassName#>Variable::Save()
{
	if (dirty == false)
	{
		return;
	}

	UGameplayStatics::SaveGameToSlot(this, GetSaveLocation(), 0);
	dirty = false;
}

void U<#=ClassName#>Variable::Load()
{
	U<#=ClassName#>Variable* LoadGameInstance = Cast<U<#=ClassName#>Variable>(UGameplayStatics::CreateSaveGameObject(U<#=ClassName#>Variable::StaticClass()));
	LoadGameInstance = Cast<U<#=ClassName#>Variable>(UGameplayStatics::LoadGameFromSlot(GetSaveLocation(), 0));
	
	if (LoadGameInstance != nullptr)
	{
		this->value = LoadGameInstance->value;
	}
}


<#+
}
#>