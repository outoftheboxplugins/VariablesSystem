<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#+ // Generate the CPP file for a generic local variable
void GenerateLocalCPPFile(string ClassName, string ClassType, string classDefault)
{
#>
// Copyright Out-of-the-Box Plugins 2018-2019. All Rights Reserved.

#include "Local<#=ClassName#>Variable.h"
#include "Kismet/GameplayStatics.h"

//void U<#=ClassName#>Variable::Set<#=ClassName#>Value(<#=ClassType#> _value)
//{
//	Set<#=ClassName#>Value(this, _value);
//}
//

//
//void U<#=ClassName#>Variable::Copy<#=ClassName#>Value(U<#=ClassName#>Variable* other)
//{
//	Copy<#=ClassName#>Value(this, other);
//}
//


<#=ClassType#> ULocal<#=ClassName#>Variable::GetLocal<#=ClassName#>(UObject* owner, ULocal<#=ClassName#>Variable* var)
{
	if (owner == nullptr)
	{
		UE_LOG(LogTemp, Warning, TEXT("Missing owner"));
		return <#=classDefault#>;
	}

	if (var == nullptr)
	{
		UE_LOG(LogTemp, Warning, TEXT("Missing variable"));
		return <#=classDefault#>;
	}
	else
	{
		return var->GetLocal<#=ClassName#>Ref(owner);
	}
}

<#=ClassType#>& ULocal<#=ClassName#>Variable::GetLocal<#=ClassName#>Ref(UObject* owner)
{
	<#=ClassType#>& value = variables.FindOrAdd(owner);
	return value;
}

void ULocal<#=ClassName#>Variable::SetLocal<#=ClassName#>Value(UObject* owner, ULocal<#=ClassName#>Variable* var, <#=ClassType#> _value)
{

	if (!var)	return;
	if (!owner) return;

	<#=ClassType#>& <#=ClassName#>Ref = var->GetLocal<#=ClassName#>Ref(owner);
	<#=ClassName#>Ref = _value;
	var->dirty = true;
}

void ULocal<#=ClassName#>Variable::CopyLocal<#=ClassName#>Value(UObject* owner, ULocal<#=ClassName#>Variable* var, UObject* otherOwner, ULocal<#=ClassName#>Variable* other)
{
	if (!var)	return;
	if (!owner) return;
	if (!otherOwner) return;
	if (!other) return;
	
	<#=ClassType#>& <#=ClassName#>Ref = var->GetLocal<#=ClassName#>Ref(owner);
	<#=ClassType#>& other<#=ClassName#>Ref = other->GetLocal<#=ClassName#>Ref(otherOwner);

	<#=ClassName#>Ref = other<#=ClassName#>Ref;
	var->dirty = true;
}

<#+
}
#>
